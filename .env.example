# Copy to .env and adjust. All values optional — defaults shown.

# --- core-lite (build-time; changing these forces a rebuild) ---
# Ticks one epoch can hold before forced seamless epoch transition.
# Default 5184000 = 60 days at 1s ticks. Smaller = less RAM/disk.
EPOCH_TICK_CAPACITY=5184000
# OFF (default): balances come from ./states/spectrum.<EPOCH> loaded at genesis.
# ON: additionally mint 10B QU to each computor/custom seed at genesis (then the
# chain state no longer matches the state files given to bob — leave OFF).
PREFILL_QUS=OFF
# ON (default): shrink node-local buffers, big RAM cut. The Dockerfile pins
# spectrum/assets depth at 24 so bob compatibility is kept (unlike stock LITE_RAM).
LITE_RAM=ON

# --- core-lite (runtime) ---
# ms per tick; 0 = unpaced, max 30000. ~50GB disk/day raw at 1000ms.
TICK_DURATION_MS=1000

# --- services ---
# "explorer" runs the full stack (default). Set empty (COMPOSE_PROFILES=) to run
# only core-lite + core-bob and save ~7 GB RAM. When empty, manage explorer
# leftovers with: docker compose --profile explorer down
COMPOSE_PROFILES=explorer

# --- host port remaps (when defaults are taken on the host) ---
CORE_LITE_P2P_PORT=31841
NGINX_PORT=80

# --- docker network ---
# Change BOTH when 10.77.0.0/24 collides with an existing network/VPN on this
# host ("Pool overlaps with other one on this address space").
# CORE_LITE_IP must be inside QUBIC_SUBNET; bob's config is generated from it.
QUBIC_SUBNET=10.77.0.0/24
CORE_LITE_IP=10.77.0.10

# --- oracle machine (optional) ---
# Enable with ./scripts/up.sh --oracle (or add "oracle" to COMPOSE_PROFILES AND
# set ORACLE_MACHINE_IP yourself). ORACLE_MACHINE_IP is both the oracle-machine
# container's static IP on qubicnet and a core-lite BUILD ARG (core-lite dials
# it at compile time) — toggling it rebuilds core-lite. Empty = disabled.
# Must be inside QUBIC_SUBNET; up.sh --oracle defaults it to 10.77.0.20.
ORACLE_MACHINE_IP=
# Exchange API keys for the price oracle service (optional — higher rate
# limits; free tier with rate limiting when empty).
BINANCE_API_KEY=
MEXC_API_KEY=
GATE_API_KEY=

# --- explorer ---
# Bob endpoint the indexer/api/analytics connect to
BOB_URL=http://core-bob:40420
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# X-Api-Key for /api/admin/* endpoints (empty = admin disabled, 503)
ADMIN_API_KEY=
INDEXER_START_TICK=0
INDEXER_START_FROM_LATEST=false
PRUNER_DRY_RUN=true
ASPNETCORE_ENVIRONMENT=Development
# true = build explorer against ./qubic-demo-explorer/src/local-packages/
USE_LOCAL_PACKAGES=false
